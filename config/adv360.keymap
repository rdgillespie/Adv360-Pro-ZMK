#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        mod_bang_1: mod_bang_1 {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_BANG_1";
            bindings = <&kp EXCLAMATION>, <&kp KP_NUMBER_1>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mod_LBkt_2: mod_LBkt_2 {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_LBKT_2";
            bindings = <&kp LBKT>, <&kp KP_NUMBER_2>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mod_LBRC_3: mod_LBRC_3 {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_LBRC_3";
            bindings = <&kp LEFT_BRACE>, <&kp KP_NUMBER_3>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mod_LP_4: mod_LP_4 {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_LP_4";
            bindings = <&kp LEFT_PARENTHESIS>, <&kp KP_NUMBER_4>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mod_Hash_5: mod_Hash_5 {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_HASH_5";
            bindings = <&kp POUND>, <&kp KP_NUMBER_5>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mod_Amp_6: mod_Amp_6 {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_AMP_6";
            bindings = <&kp AMPERSAND>, <&kp KP_NUMBER_6>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mod_RP_7: mod_RP_7 {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_RP_7";
            bindings = <&kp RIGHT_PARENTHESIS>, <&kp KP_NUMBER_7>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mod_RBRC_8: mod_RBRC_8 {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_RBRC_8";
            bindings = <&kp RIGHT_BRACE>, <&kp KP_NUMBER_8>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mod_RBKT_9: mod_RBKT_9 {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_RBKT_9";
            bindings = <&kp RIGHT_BRACKET>, <&kp KP_NUMBER_9>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mod_Dol_0: mod_Dol_0 {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_DOL_0";
            bindings = <&kp DOLLAR>, <&kp KP_NUMBER_0>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mod_AT_PCT: mod_AT_PCT {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_AT_PCT";
            bindings = <&kp AT_SIGN>, <&kp PERCENT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mod_Astx_Car: mod_Astx_Car {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_ASTX_CAR";
            bindings = <&kp ASTERISK>, <&kp CARET>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &mod_bang_1  &mod_LBkt_2  &mod_LBRC_3  &mod_LP_4  &mod_Hash_5  &none                                                            &mo 2              &mod_Amp_6  &mod_RP_7  &mod_RBRC_8  &mod_RBKT_9  &mod_Dol_0     &kp MINUS
&kp TAB    &kp Q        &kp W        &kp E        &kp R      &kp T        &none                                                            &none              &kp Y       &kp U      &kp I        &kp O        &kp P          &kp BSLH
&kp ESC    &kp A        &kp S        &kp D        &kp F      &kp G        &kp LG(LC(LEFT))  &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &kp LG(LC(RIGHT))  &kp H       &kp J      &kp K        &kp L        &kp SEMI       &kp SQT
&kp LSHFT  &kp Z        &kp X        &kp C        &kp V      &kp B                                     &kp HOME      &kp PG_UP                                &kp N       &kp M      &kp COMMA    &kp DOT      &kp FSLH       &kp RSHFT
&mo 1      &kp GRAVE    &none        &kp LEFT     &kp RIGHT               &kp BSPC          &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp SPACE                      &kp DOWN   &kp UP       &mod_AT_PCT  &mod_Astx_Car  &mo 1
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 0                                      &mo 2   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
